{
  "compilerOptions": {
    "module": "ESNext",
    "allowJs": true,
    "outDir": "dist",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "typeRoots": ["node_modules/@types", "src/typings"],
    "types": ["node"],
    "skipLibCheck": true,
    "target": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": "src",
    "paths": {
      "@i18n": ["i18n"],
    }
  },
  "types": [

  ],
  "include": [
    "src/**/*",
   
  ],
}
